# API key — required for Jev API layer (deterministic rules work without it)
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Jev API endpoint — switch between TypeSafe, OpenRouter, or Vercel AI Gateway
# TypeSafe AI (eval):
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# OpenRouter (eval):
# JEV_ENDPOINT=https://openrouter.ai/api/v1/decisions
# Vercel AI Gateway (eval):
# JEV_ENDPOINT=https://ai-gateway.vercel.sh/v1/evaluate

# Model name sent with each API request (default: auto-selected from provider)
JEV_MODEL=jev-latest

# Optional override (takes priority over env vars above)
JEV_API_KEY=

# Audit log output path (default: $HOME/.hermes/guard/audit.jsonl)
AUDIT_PATH=

# Server listen address
LISTEN=127.0.0.1:8787